# Feishu Bot Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Feishu Application Credentials
# ============================================
# Get these from: https://open.feishu.cn/app/
# Navigate to: Credentials & Basic Info (凭证与基础信息)

# Your Feishu App ID (format: cli_xxxxxx)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# Your Feishu App Secret
FEISHU_APP_SECRET=your_app_secret_here

# Verification Token (used to verify webhook requests)
FEISHU_VERIFICATION_TOKEN=your_verification_token

# Encrypt Key (if using message encryption)
FEISHU_ENCRYPT_KEY=your_encrypt_key

# ============================================
# Application Configuration
# ============================================

# Server port
PORT=3000

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Node environment (development, production)
NODE_ENV=production

# ============================================
# Webhook Configuration
# ============================================

# Public URL where Feishu can reach your bot
# This must be accessible from the internet
WEBHOOK_URL=https://your-domain.com/webhook

# Webhook path (default: /webhook)
WEBHOOK_PATH=/webhook

# ============================================
# Feature Flags
# ============================================

# Enable streaming cards (requires cardkit:card:write permission)
ENABLE_STREAMING_CARDS=true

# Enable message encryption
ENABLE_MESSAGE_ENCRYPTION=false

# Enable event verification
ENABLE_EVENT_VERIFICATION=true

# ============================================
# Advanced Configuration
# ============================================

# Feishu API base URL (usually no need to change)
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# Request timeout (in milliseconds)
API_TIMEOUT=30000

# Max retries for failed API calls
MAX_RETRIES=3

# Token cache TTL (in seconds)
TOKEN_CACHE_TTL=7200

# ============================================
# Optional: Database Configuration
# ============================================

# If you need to persist data
# DATABASE_URL=postgresql://user:password@localhost:5432/clowbot

# ============================================
# Optional: Redis Configuration
# ============================================

# For caching and session management
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# ============================================
# Required Permissions Checklist
# ============================================
# Make sure these permissions are enabled in your Feishu app console:
# 
# REQUIRED:
# ✅ cardkit:card:write      - Create and update streaming cards (CRITICAL!)
# ✅ im:message              - Send and receive messages
# ✅ im:message.group_at_msg - Receive group @ mentions
#
# OPTIONAL:
# ⭕ im:resource             - Upload and manage resources (images, files)
# ⭕ contact:user.base       - Get user basic information
#
# IMPORTANT: Without cardkit:card:write, you will see errors like:
# "Failed to create streaming card: Access denied. One of the following scopes is required: [cardkit:card:write]"
#
# To enable permissions:
# 1. Go to https://open.feishu.cn/app/
# 2. Select your application
# 3. Navigate to "Permissions & Scopes" (权限管理)
# 4. Search for the permission name
# 5. Click "Apply" (申请权限) then "Activate" (开通)
# 6. Restart your application after enabling permissions
